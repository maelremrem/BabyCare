{
  "name": "babycare",
  "private": true,
  "version": "0.2.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:all": "npm run build:distribution && concurrently -k -n API,MODERN,IOS15 -c magenta,green,cyan \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:ios15:serve\"",
    "dev:client": "vite",
    "dev:ios15": "npm run build:distribution && npm run dev:server",
    "dev:ios15:serve": "vite preview --outDir dist-ios15",
    "dev:server": "node server/app.js",
    "build": "tsc -b && vite build",
    "build:modern": "tsc -b && vite build --mode modern",
    "build:ios15": "tsc -b && vite build --mode ios15",
    "build:distribution": "npm run build:modern && npm run build:ios15",
    "build:pages": "tsc -b && vite build --mode demo",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "eslint . --max-warnings=0",
    "start": "node server/app.js",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "node --test server/**/*.test.js",
    "test:ui": "vitest run",
    "typecheck": "tsc -b",
    "verify:native-runtime": "node scripts/verify-native-runtime.js",
    "backup": "node server/backup-cli.js backup",
    "restore": "node server/backup-cli.js restore"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-tabs": "1.1.21",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "lucide-react": "1.37.0",
    "next-themes": "0.4.6",
    "nosleep.js": "0.12.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
