{
  "name": "babycare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/app.js",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && VITE_DEMO_MODE=true VITE_BASE_PATH=/BabyCare/ vite build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "eslint . --max-warnings=0",
    "start": "node server/app.js",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "node --test server/**/*.test.js",
    "test:ui": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-popover": "latest",
    "@radix-ui/react-scroll-area": "latest",
    "@radix-ui/react-tabs": "latest",
    "better-sqlite3": "^12.4.6",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "exceljs": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "^30.0.1",
    "tailwindcss": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vitest": "^4.1.11"
  }
}
